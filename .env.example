CRONOMETER_USERNAME=you@example.com
CRONOMETER_PASSWORD=your-password
CRONOMETER_TIMEZONE=America/Sao_Paulo
CRONOMETER_ENV_FILE=.env

# Optional write mode. Leave disabled unless you want the MCP to change your
# Cronometer diary. add_food_to_diary still requires confirm=true and
# dry_run=false on each write call.
CRONOMETER_ENABLE_WRITE=false

# Optional external write adapter. Leave blank to use the native Cronometer GWT
# write path implemented in this repository.
CRONOMETER_ADD_FOOD_COMMAND=
